#!/bin/bash
#SBATCH --job-name=helhest_survey
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=3:00:00
#SBATCH --partition=cpu
#SBATCH --output=slurm/slurm_out/survey_%A_%a.out
#
# scripts/survey_v2_bag.py over one bag of docs/v2_inventory.csv (array index =
# 0-based row) into <out>/<session>/<bag>/; the bag itself is discarded.
#
#   sbatch --array=20-23,33-51%4 slurm/survey_v2.batch      # the bags no root has seen
set -uo pipefail

OUT=${1:-/mnt/personal/$USER/HELHEST_v2_survey}
REPO=${REPO:-${SLURM_SUBMIT_DIR:-$PWD}}
. "$REPO/slurm/common.sh" || { echo "not a dataset_tools checkout: $REPO -- submit from the repository root"; exit 1; }
CSV=${CSV:-$REPO/docs/v2_inventory.csv}

read_row
session=$(echo "$row" | cut -d, -f1)
bagname=$(echo "$row" | cut -d, -f2)
dest="$OUT/$session/$bagname"
[ -e "$dest/summary.json" ] && { echo "$bagname already surveyed"; exit 0; }

make_scratch survey
bag="$SCRATCH/$bagname"
fetch_bag "$bagname" "$bag"

mkdir -p "$SCRATCH/out"
singularity exec $BINDS "$SIF" "$PY" "$REPO/scripts/survey_v2_bag.py" "$bag" "$SCRATCH/out"
rc=$?
echo "[$(date '+%F %T')] $bagname survey rc=$rc"
[ $rc -eq 0 ] && { mkdir -p "$dest" && rsync -a "$SCRATCH/out/" "$dest/"; }
exit $rc
