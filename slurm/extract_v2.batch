#!/bin/bash
#SBATCH --job-name=helhest_v2
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=6:00:00
#SBATCH --partition=cpu
#SBATCH --output=slurm/slurm_out/v2_%A_%a.out
#
# HELHEST v2 (Odin1 + Fixposition) extraction, one bag per array task, through
# odom_frame, the height maps and validation: a finished scene leaves this
# task. Staged on node-local NVMe; NFS is touched only for the sif, the repo
# and the final copy. Timing (--time_align auto) and the GNSS guard
# (--gnss_guard auto) are the extractor's defaults; see docs/NEW_RIG_READINESS.md.
#
#   CSV=docs/v2_4_bags.csv sbatch --array=0-35%4 slurm/extract_v2.batch /mnt/personal/$USER/HELHEST_v2_4
#
# Array index = 0-based row of $CSV = scene number; pass CSV and out_root every
# time, their defaults are the v2 beta list and root. A scene with
# source_bag.txt is skipped, so re-submitting resumes. %4: subtdata sustains
# ~50 MB/s aggregate. FORCE=1 re-extracts (--overwrite):
#
#   FORCE=1 CSV=docs/v2_4_bags.csv sbatch --array=7 slurm/extract_v2.batch /mnt/personal/$USER/HELHEST_v2_4
set -uo pipefail

OUT=${1:-/mnt/personal/$USER/HELHEST_v2_beta}
# Submit from the repository root: slurm runs a spooled copy, so $0 is useless.
REPO=${REPO:-${SLURM_SUBMIT_DIR:-$PWD}}
. "$REPO/slurm/common.sh" || { echo "not a dataset_tools checkout: $REPO -- submit from the repository root"; exit 1; }
CSV=${CSV:-$REPO/docs/v2_bags.csv}

read_row
scene=$(echo "$row" | cut -d, -f1)
FORCE=${FORCE:-0}
if [ "$FORCE" != "1" ] && [ -e "$OUT/$scene/source_bag.txt" ]; then
    # Refuse if a changed bag list now puts another bag at this index.
    held=$(cat "$OUT/$scene/source_bag.txt")
    if [ "$held" = "$(basename "$bagdir")" ]; then
        echo "$scene already complete"; exit 0
    fi
    echo "$scene holds $held but $CSV puts $(basename "$bagdir") here -- refusing; FORCE=1 replaces it"
    exit 13
fi
EXTRA=""
[ "$FORCE" = "1" ] && EXTRA="--overwrite"
# Extractor options: the bag list's own (its extract_args column, e.g.
# "--trim_idle 60 10"), then this submission's EXTRACT_ARGS.
EXTRA="$EXTRA $row_args ${EXTRACT_ARGS:-}"

# Needs room for the bag (<= 44 GB) and the extracted scene (<= 90 GB).
make_scratch v2
stage="$SCRATCH/stage"; local_out="$SCRATCH/out"
mkdir -p "$stage" "$local_out"
bag="$stage/$(basename "$bagdir")"
fetch_bag "$scene" "$bag"

echo "[$(date '+%F %T')] $scene extract"
singularity exec $BINDS "$SIF" "$PY" -m dataset_tools.extract \
    "$stage" "$local_out" --start_index "$((10#$scene))" --jobs 1 $EXTRA
rc=$?
echo "[$(date '+%F %T')] $scene extract rc=$rc"
[ -e "$local_out/$scene/source_bag.txt" ] || { echo "$scene: no scene produced"; exit 11; }

# Odometry onto the cloud frame (dataset_tools.odom_frame) before the height maps,
# which level the clouds with gravity_align.npy. Needs open3d (the "build" extra),
# whose wheel needs a newer glibc than the cpu nodes have -- inside the image it
# loads. A scene it cannot measure keeps its odometry; a measured fit that fails
# to apply fails the scene (apply is crash-safe, so that is a real error).
if [ -s "$local_out/$scene/odometry.txt" ] && [ -d "$local_out/$scene/clouds" ]; then
    echo "[$(date '+%F %T')] $scene odometry onto the cloud frame"
    of() { singularity exec $BINDS "$SIF" env OMP_NUM_THREADS=8 "$PY" -m dataset_tools.odom_frame "$@"; }
    if of measure "$local_out" --scenes "$scene" --fits "$SCRATCH/odom_frame_fit.json"; then
        of apply "$local_out" --scenes "$scene" --fits "$SCRATCH/odom_frame_fit.json" --note "applied in extract_v2.batch"
        arc=$?
        [ $arc -eq 0 ] || { echo "$scene: ODOM_FRAME APPLY FAILED (rc=$arc) -- not published"; exit 15; }
    else
        echo "$scene: WARNING odom_frame not measured -- odometry and gravity_align are the Odin1's own"
    fi
fi

# Height maps and masks (dataset_tools.heightmap, the v2 settings), in this task,
# from the clouds and the gravity_align.npy just written, so a re-extraction can
# never leave maps of the run before it.
echo "[$(date '+%F %T')] $scene height maps"
singularity exec $BINDS "$SIF" "$PY" -m dataset_tools.heightmap "$local_out" \
    --scenes "$scene" --workers "${SLURM_CPUS_PER_TASK:-16}" --overwrite
hmrc=$?
echo "[$(date '+%F %T')] $scene height maps rc=$hmrc"
[ $hmrc -eq 0 ] || { echo "$scene: HEIGHT MAPS FAILED (rc=$hmrc) -- not published"; exit 16; }

mkdir -p "$OUT/.validation"
# Validated last, on the files that get published. A scene failing validation
# is not published unless FORCE_PUBLISH=1.
singularity exec $BINDS "$SIF" "$PY" -m dataset_tools.validate_scene \
    "$local_out/$scene" --csv "$SCRATCH/validation.csv"
vrc=$?
if [ $vrc -ne 0 ]; then
    if [ "${FORCE_PUBLISH:-0}" != "1" ]; then
        echo "$scene: VALIDATION FAILED (rc=$vrc) -- not published; FORCE_PUBLISH=1 publishes anyway"
        exit 14
    fi
    echo "$scene: validation failed (rc=$vrc), published anyway (FORCE_PUBLISH=1)"
fi

echo "[$(date '+%F %T')] $scene publish -> $OUT/$scene ($(du -sh "$local_out/$scene" | cut -f1))"
mkdir -p "$OUT"
# Copied beside the scene, then swapped in whole: a re-extraction may have fewer
# frames (no stale tail survives), and a failed copy leaves the old scene as it
# was. cp, not rsync: rsync's per-file temp+rename+chmod cost 6x on WekaFS
# (2000 clouds: 6.4 s vs 1.0 s).
tmp="$OUT/.$scene.publish"; old="$OUT/.$scene.old"
rm -rf "$tmp" "$old"
cp -r "$local_out/$scene" "$tmp" || { rm -rf "$tmp"; echo "$scene: publish failed"; exit 12; }
{ [ ! -e "$OUT/$scene" ] || mv "$OUT/$scene" "$old"; } && mv "$tmp" "$OUT/$scene" ||
    { echo "$scene: publish failed (new copy in $tmp, any old scene in $old)"; exit 12; }
rm -rf "$old"
cp -f "$SCRATCH/validation.csv" "$OUT/.validation/$scene.csv" 2>/dev/null
echo "[$(date '+%F %T')] $scene finished rc=$rc"
exit $rc
