#!/bin/bash
#SBATCH --job-name=helhest_v2
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=6:00:00
#SBATCH --partition=cpu
#SBATCH --output=slurm/slurm_out/v2_%A_%a.out
#
# HELHEST v2 (new rig: Odin1 + Fixposition) extraction, ONE BAG PER ARRAY TASK,
# through to the height maps -- a finished scene leaves this script, not a scene
# that still needs a second job run over it. 16 CPUs because of that last stage:
# the extraction itself is --jobs 1 and IO-bound, the map build is not.
#
# Staged entirely on node-local NVMe so the shared NFS is touched only for the
# sif, the repo, and one final rsync of the finished scene. No FAST-LIO stage,
# unlike the v1 regeneration: the new rig ships its own
# ground truth (/odin1/odometry, checked against /fixposition/odometry_enu), so
# no --lidar_extrinsic is needed - the Odin mount extrinsic is in tf_static from
# 2026-09-02 onwards (docs/NEW_RIG_READINESS.md §4).
#
# Nothing about timing is set here. The Odin1 stamps at publish rather than at
# capture, so its headers are late by its own pipeline latency - ~0.69 s, and
# not even constant within one bag - and the extractor measures that against
# the clouds it has just written and takes it off the frame clock itself
# (--time_align auto, the default). Each scene carries the measurement it was
# corrected by in time_align.txt. Background: docs/NEW_RIG_READINESS.md §6,
# "The Odin1 stamps late".
#
# Nothing about the GNSS is set here either. When the Fixposition loses its fix
# - which is what rolling the robot over does - it keeps publishing odometry at
# full rate, filled with a position hundreds of metres away held perfectly
# still, and nothing in the recording flags it. --gnss_guard auto finds those
# stretches and removes them, along with the frames they leave without a pose,
# so a scene may come out shorter than its bag. The same stage drops frames the
# pose stream never covered - before it starts, after it ends, or inside a hole
# too wide to interpolate across - which would otherwise be exported carrying
# the nearest sample: a stationary pose under a moving image. Recorded per scene
# in gnss_guard.txt; the holes read as 'fix_lost' in odometry_segments.txt.
#
#   sbatch --array=0-8%4  slurm/extract_v2.batch [out_root]     # 26-09-02
#   sbatch --array=9-16%4 slurm/extract_v2.batch [out_root]     # 26-09-08
#   CSV=docs/v2_0_bags.csv sbatch --array=0-N%4 slurm/extract_v2.batch /mnt/personal/$USER/HELHEST_v2_0
#
# Array index = row number in the bag list ($CSV, docs/v2_bags.csv by default;
# 0-based) = scene number. A scene whose <out_root>/<scene>/source_bag.txt
# exists exits immediately, so re-submitting resumes. %4 limits concurrent fetches - subtdata sustains
# ~50 MB/s aggregate; more jobs only starve each other.
#
# FORCE=1 re-extracts a scene that is already complete (--overwrite). Height
# maps are rebuilt in the same task, from the clouds and the gravity_align.npy
# this run just wrote, so a re-extraction can no longer leave a scene whose maps
# belong to the run before it.
#
#   FORCE=1 sbatch --array=0-16%4 slurm/extract_v2.batch
#
# Which bags a list leaves out, and why, is docs/V2_0_SELECTION.md's business.
set -uo pipefail

OUT=${1:-/mnt/personal/$USER/HELHEST_v2_beta}
# Submit from the repository root (see slurm/README.md): slurm runs a copy of
# this file from its spool, so the checkout is found through the submit
# directory rather than through $0, and --output above is relative to it too.
REPO=${REPO:-${SLURM_SUBMIT_DIR:-$PWD}}
. "$REPO/slurm/common.sh" || { echo "not a dataset_tools checkout: $REPO -- submit from the repository root"; exit 1; }
# The bag list is what makes a root: row = scene number. v2 beta was built
# from docs/v2_bags.csv; a root with a different selection passes its own.
CSV=${CSV:-$REPO/docs/v2_bags.csv}

read_row
scene=$(echo "$row" | cut -d, -f1)
FORCE=${FORCE:-0}
if [ "$FORCE" != "1" ] && [ -e "$OUT/$scene/source_bag.txt" ]; then
    # Complete, but from which bag? A changed bag list puts another bag here.
    held=$(cat "$OUT/$scene/source_bag.txt")
    if [ "$held" = "$(basename "$bagdir")" ]; then
        echo "$scene already complete"; exit 0
    fi
    echo "$scene holds $held but $CSV puts $(basename "$bagdir") here -- refusing; FORCE=1 replaces it"
    exit 13
fi
EXTRA=""
[ "$FORCE" = "1" ] && EXTRA="--overwrite"
# Extra extractor options for this submission, e.g. EXTRACT_ARGS="--trim_idle 60 10".
EXTRA="$EXTRA ${EXTRACT_ARGS:-}"

# Needs room for the bag (<= 44 GB) and the extracted scene (<= 90 GB).
make_scratch v2
stage="$SCRATCH/stage"; local_out="$SCRATCH/out"
mkdir -p "$stage" "$local_out"
bag="$stage/$(basename "$bagdir")"
fetch_bag "$scene" "$bag"

echo "[$(date '+%F %T')] $scene extract"
singularity exec $BINDS "$SIF" "$PY" -m dataset_tools.extract \
    "$stage" "$local_out" --start_index "$((10#$scene))" --jobs 1 $EXTRA
rc=$?
echo "[$(date '+%F %T')] $scene extract rc=$rc"
[ -e "$local_out/$scene/source_bag.txt" ] || { echo "$scene: no scene produced"; exit 11; }

mkdir -p "$OUT/.validation"
# A scene that fails validation is not published over the root's copy;
# FORCE_PUBLISH=1 publishes it anyway (and says so).
singularity exec $BINDS "$SIF" "$PY" -m dataset_tools.validate_scene \
    "$local_out/$scene" --csv "$SCRATCH/validation.csv"
vrc=$?
if [ $vrc -ne 0 ]; then
    if [ "${FORCE_PUBLISH:-0}" != "1" ]; then
        echo "$scene: VALIDATION FAILED (rc=$vrc) -- not published; FORCE_PUBLISH=1 publishes anyway"
        exit 14
    fi
    echo "$scene: validation failed (rc=$vrc), published anyway (FORCE_PUBLISH=1)"
fi

# Height maps + validity masks, in this task, against the clouds and the
# gravity_align.npy this task just wrote. They used to be a separate submission
# in DRIFT, which meant every re-extraction left a root whose maps belonged to
# the run before it -- maps are clouds rotated by gravity_align.npy, so a change
# in timing or in which frames exist silently invalidates them.
#
# DRIFT still owns the generator: it defines the map format, the parameters
# every published map was built with, and the known-answer gate that refuses to
# run if it cannot reproduce existing maps from existing clouds. So this calls
# DRIFT's own batch as a plain script rather than restating its settings here --
# there is one definition of what a height map is, and it is not in this repo.
# It takes the root as $1 and the scene from SLURM_ARRAY_TASK_ID, the same index
# this script uses, and publishes into $local_out/$scene, so the maps travel out
# on the publish rsync below with everything else.
DRIFT=${DRIFT:-$HOME/projects/DRIFT}

# The Odin1 odometry onto the frame of its clouds (dataset_tools.odom_frame),
# before the maps level the clouds with gravity_align.npy. The measurement is
# ICP between clouds and needs open3d, which DRIFT's environment has and the
# extraction image does not. A scene the measurement cannot settle (too little
# driving) keeps its odometry as extracted and says so; its maps then carry the
# few-tenths-of-a-degree tilt this step removes elsewhere.
if [ -s "$local_out/$scene/odometry.txt" ] && [ -d "$local_out/$scene/clouds" ]; then
    echo "[$(date '+%F %T')] $scene odometry onto the cloud frame"
    ( cd "$DRIFT" && source .env >/dev/null && export PYTHONPATH="$REPO" OMP_NUM_THREADS=8 &&
      python3 -m dataset_tools.odom_frame measure "$local_out" --scenes "$scene" --fits "$SCRATCH/odom_frame_fit.json" &&
      python3 -m dataset_tools.odom_frame apply "$local_out" --scenes "$scene" --fits "$SCRATCH/odom_frame_fit.json" \
          --note "applied in extract_v2.batch" )
    [ $? -eq 0 ] || echo "$scene: WARNING odom_frame not applied -- odometry and gravity_align are the Odin1's own"
fi

HM=$DRIFT/slurm/build_heightmaps_v2_beta.batch
if [ -x "$HM" ] || [ -f "$HM" ]; then
    echo "[$(date '+%F %T')] $scene height maps"
    bash "$HM" "$local_out"
    hmrc=$?
    nmaps=$(find "$local_out/$scene/height_maps" -name '*.npz' 2>/dev/null | wc -l)
    echo "[$(date '+%F %T')] $scene height maps rc=$hmrc, $nmaps built"
    [ $hmrc -eq 0 ] || { echo "$scene: HEIGHT MAPS FAILED (rc=$hmrc) -- scene published without them"; }
else
    echo "$scene: WARNING no height-map builder at $HM; scene published without maps"
fi

echo "[$(date '+%F %T')] $scene publish -> $OUT/$scene ($(du -sh "$local_out/$scene" | cut -f1))"
mkdir -p "$OUT"
# --delete, because the node-local scene is the whole truth about this scene.
# The pose guard can remove frames (dataset_tools.gnss_guard), so a re-extraction
# may produce FEWER frames than the run before it; merging would leave the tail
# of the old run behind, under indices that now mean different moments.
rsync -a --delete "$local_out/$scene/" "$OUT/$scene/" || { echo "$scene: publish failed"; exit 12; }
cp -f "$SCRATCH/validation.csv" "$OUT/.validation/$scene.csv" 2>/dev/null
echo "[$(date '+%F %T')] $scene finished rc=$rc"
exit $rc
