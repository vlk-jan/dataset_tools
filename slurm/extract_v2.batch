#!/bin/bash
#SBATCH --job-name=helhest_v2
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=6:00:00
#SBATCH --partition=cpu
#SBATCH --output=slurm/slurm_out/v2_%A_%a.out
#
# HELHEST v2 (Odin1 + Fixposition) extraction, one bag per array task, through
# to the height maps. Staged on node-local NVMe; NFS is touched only for the sif,
# the repo and the final rsync. Timing (--time_align auto) and the GNSS guard
# (--gnss_guard auto) are the extractor's defaults; see docs/NEW_RIG_READINESS.md.
#
#   sbatch --array=0-8%4  slurm/extract_v2.batch [out_root]     # 26-09-02
#   sbatch --array=9-16%4 slurm/extract_v2.batch [out_root]     # 26-09-08
#   CSV=docs/v2_0_bags.csv sbatch --array=0-N%4 slurm/extract_v2.batch /mnt/personal/$USER/HELHEST_v2_0
#
# Array index = 0-based row of $CSV (docs/v2_bags.csv by default) = scene number.
# A scene with source_bag.txt is skipped, so re-submitting resumes. %4: subtdata
# sustains ~50 MB/s aggregate. FORCE=1 re-extracts (--overwrite):
#
#   FORCE=1 sbatch --array=0-16%4 slurm/extract_v2.batch
set -uo pipefail

OUT=${1:-/mnt/personal/$USER/HELHEST_v2_beta}
# Submit from the repository root: slurm runs a spooled copy, so $0 is useless.
REPO=${REPO:-${SLURM_SUBMIT_DIR:-$PWD}}
. "$REPO/slurm/common.sh" || { echo "not a dataset_tools checkout: $REPO -- submit from the repository root"; exit 1; }
CSV=${CSV:-$REPO/docs/v2_bags.csv}

read_row
scene=$(echo "$row" | cut -d, -f1)
FORCE=${FORCE:-0}
if [ "$FORCE" != "1" ] && [ -e "$OUT/$scene/source_bag.txt" ]; then
    # Refuse if a changed bag list now puts another bag at this index.
    held=$(cat "$OUT/$scene/source_bag.txt")
    if [ "$held" = "$(basename "$bagdir")" ]; then
        echo "$scene already complete"; exit 0
    fi
    echo "$scene holds $held but $CSV puts $(basename "$bagdir") here -- refusing; FORCE=1 replaces it"
    exit 13
fi
EXTRA=""
[ "$FORCE" = "1" ] && EXTRA="--overwrite"
# Extra extractor options for this submission, e.g. EXTRACT_ARGS="--trim_idle 60 10".
EXTRA="$EXTRA ${EXTRACT_ARGS:-}"

# Needs room for the bag (<= 44 GB) and the extracted scene (<= 90 GB).
make_scratch v2
stage="$SCRATCH/stage"; local_out="$SCRATCH/out"
mkdir -p "$stage" "$local_out"
bag="$stage/$(basename "$bagdir")"
fetch_bag "$scene" "$bag"

echo "[$(date '+%F %T')] $scene extract"
singularity exec $BINDS "$SIF" "$PY" -m dataset_tools.extract \
    "$stage" "$local_out" --start_index "$((10#$scene))" --jobs 1 $EXTRA
rc=$?
echo "[$(date '+%F %T')] $scene extract rc=$rc"
[ -e "$local_out/$scene/source_bag.txt" ] || { echo "$scene: no scene produced"; exit 11; }

# Height maps are built in this task so they always match this run's clouds and
# gravity_align.npy. DRIFT owns the generator; its batch takes the root as $1 and
# the scene from SLURM_ARRAY_TASK_ID, writing into $local_out/$scene.
DRIFT=${DRIFT:-$HOME/projects/DRIFT}

# Odometry onto the cloud frame (dataset_tools.odom_frame) before the height maps.
# Needs open3d from DRIFT's venv, run inside the image: its wheel needs a newer
# glibc than the cpu nodes have. A scene it cannot measure keeps its odometry;
# a measured fit that fails to apply fails the scene (apply is crash-safe, so
# that is a real error, not a half-written scene to publish).
O3D_PY=${O3D_PY:-$DRIFT/.venv/bin/python}
if [ -s "$local_out/$scene/odometry.txt" ] && [ -d "$local_out/$scene/clouds" ]; then
    echo "[$(date '+%F %T')] $scene odometry onto the cloud frame"
    of() { singularity exec $BINDS --bind "$HOME" "$SIF" env PYTHONPATH="$REPO" OMP_NUM_THREADS=8 "$O3D_PY" -m dataset_tools.odom_frame "$@"; }
    if of measure "$local_out" --scenes "$scene" --fits "$SCRATCH/odom_frame_fit.json"; then
        of apply "$local_out" --scenes "$scene" --fits "$SCRATCH/odom_frame_fit.json" --note "applied in extract_v2.batch"
        arc=$?
        [ $arc -eq 0 ] || { echo "$scene: ODOM_FRAME APPLY FAILED (rc=$arc) -- not published"; exit 15; }
    else
        echo "$scene: WARNING odom_frame not measured -- odometry and gravity_align are the Odin1's own"
    fi
fi

mkdir -p "$OUT/.validation"
# Validated after odom_frame, on the files that get published. A scene failing
# validation is not published unless FORCE_PUBLISH=1.
singularity exec $BINDS "$SIF" "$PY" -m dataset_tools.validate_scene \
    "$local_out/$scene" --csv "$SCRATCH/validation.csv"
vrc=$?
if [ $vrc -ne 0 ]; then
    if [ "${FORCE_PUBLISH:-0}" != "1" ]; then
        echo "$scene: VALIDATION FAILED (rc=$vrc) -- not published; FORCE_PUBLISH=1 publishes anyway"
        exit 14
    fi
    echo "$scene: validation failed (rc=$vrc), published anyway (FORCE_PUBLISH=1)"
fi

HM=$DRIFT/slurm/build_heightmaps_v2_beta.batch
if [ -x "$HM" ] || [ -f "$HM" ]; then
    echo "[$(date '+%F %T')] $scene height maps"
    bash "$HM" "$local_out"
    hmrc=$?
    nmaps=$(find "$local_out/$scene/height_maps" -name '*.npz' 2>/dev/null | wc -l)
    echo "[$(date '+%F %T')] $scene height maps rc=$hmrc, $nmaps built"
    [ $hmrc -eq 0 ] || { echo "$scene: HEIGHT MAPS FAILED (rc=$hmrc) -- scene published without them"; }
else
    echo "$scene: WARNING no height-map builder at $HM; scene published without maps"
fi

echo "[$(date '+%F %T')] $scene publish -> $OUT/$scene ($(du -sh "$local_out/$scene" | cut -f1))"
mkdir -p "$OUT"
# --delete: a re-extraction may have fewer frames; stale tail frames must go.
rsync -a --delete "$local_out/$scene/" "$OUT/$scene/" || { echo "$scene: publish failed"; exit 12; }
cp -f "$SCRATCH/validation.csv" "$OUT/.validation/$scene.csv" 2>/dev/null
echo "[$(date '+%F %T')] $scene finished rc=$rc"
exit $rc
