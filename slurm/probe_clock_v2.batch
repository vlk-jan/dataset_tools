#!/bin/bash
#SBATCH --job-name=helhest_skew
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=2:00:00
#SBATCH --partition=cpu
#SBATCH --output=/home/vlkjan6/projects/dataset_tools/slurm/slurm_out/skew_%A_%a.out
#
# scripts/probe_clock_skew.py over a v2 bag: what each publisher's clock was
# doing against the recorder's, and when it moved. Same fetch-to-node-local
# shape as extract_v2.batch, and the same array indexing (row of
# docs/v2_bags.csv = scene number), so
#
#   sbatch --array=0 slurm/probe_clock_v2.batch          # just scene 0000
#   sbatch --array=0-16%4 slurm/probe_clock_v2.batch     # the whole rig
#
# writes <out>/<scene>_skew.csv plus the per-topic summary in the slurm log.
set -uo pipefail

OUT=${1:-/mnt/personal/vlkjan6/HELHEST_v2_beta/.clock_skew}
REPO=/home/vlkjan6/projects/dataset_tools
CSV=$REPO/docs/v2_bags.csv
SIF=/mnt/data/vras/data/helhest-jazzy.sif
SUBTDATA=vlkjan6@subtdata.felk.cvut.cz
PY="$REPO/.venv/bin/python"

row=$(tail -n +2 "$CSV" | sed -n "$((SLURM_ARRAY_TASK_ID + 1))p")
[ -n "$row" ] || { echo "no row $SLURM_ARRAY_TASK_ID in $CSV"; exit 1; }
scene=$(echo "$row" | cut -d, -f1)
bagdir=$(echo "$row" | cut -d, -f3)

SCRATCH=""
for c in /data/temporary/$USER /data/$USER /tmp/$USER; do
    mkdir -p "$c/skew_${SLURM_JOB_ID}" 2>/dev/null && SCRATCH="$c/skew_${SLURM_JOB_ID}" && break
done
[ -n "$SCRATCH" ] || { echo "no writable scratch"; exit 1; }
trap 'rm -rf "$SCRATCH"' EXIT
bag="$SCRATCH/$(basename "$bagdir")"
BINDS="--bind /mnt/personal --bind /mnt/data --bind $SCRATCH"

echo "[$(date '+%F %T')] $scene fetch $bagdir"
rsync -a --partial "$SUBTDATA:$bagdir/" "$bag/" || { echo "$scene: fetch failed"; exit 10; }
echo "[$(date '+%F %T')] $scene fetched $(du -sh "$bag" | cut -f1)"

mkdir -p "$OUT"
singularity exec $BINDS "$SIF" "$PY" "$REPO/scripts/probe_clock_skew.py" \
    "$bag" --bin 5 --csv "$OUT/${scene}_skew.csv"
rc=$?
echo "[$(date '+%F %T')] $scene skew probe rc=$rc"
exit $rc
