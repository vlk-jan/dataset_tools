#!/bin/bash

#SBATCH --job-name=helhest_extract
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=4:00:00
#SBATCH --partition=cpufast
#SBATCH --output=slurm/slurm_out/extract_%j.out
#SBATCH --error=slurm/slurm_out/extract_%j.err

set -euo pipefail

# Extract one directory of bags (Odin1 + Fixposition stack) into one root.
#
#   sbatch slurm/slurm_extract.batch [bags_dir] [out_root]
#
# Runs inside the sif (the venv uses its Python); /mnt mounts must be bound.
# Complete scenes are skipped, so re-queueing resumes. Submit from the repo root.

REPO=${REPO:-${SLURM_SUBMIT_DIR:-$PWD}}
. "$REPO/slurm/common.sh" || { echo "not a dataset_tools checkout: $REPO -- submit from the repository root"; exit 1; }
BAGS=${1:-/mnt/personal/$USER/helhest_new/bags_raw}
OUT=${2:-/mnt/personal/$USER/helhest_new}

singularity exec --bind /mnt/personal --bind /mnt/data "$SIF" \
    "$PY" -m dataset_tools.extract "$BAGS" "$OUT" --jobs 8

# Sanity-check what came out (non-zero exit on structural problems).
singularity exec --bind /mnt/personal --bind /mnt/data "$SIF" \
    "$PY" -m dataset_tools.validate_scene "$OUT" --csv "$OUT/validation.csv"
