#!/bin/bash

#SBATCH --job-name=helhest_extract
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=4:00:00
#SBATCH --partition=cpufast
#SBATCH --output=slurm/slurm_out/extract_%j.out
#SBATCH --error=slurm/slurm_out/extract_%j.err

set -euo pipefail

# Extract one directory of bags (Odin1 + Fixposition stack) into one root.
#
#   sbatch slurm/slurm_extract.batch [bags_dir] [out_root]
#
# The venv was built with the container's Python 3.12, so it must run inside
# the sif. Bind every filesystem that is read or written: neither /mnt/data nor
# /mnt/personal is mounted inside the container by default.
#
# Already-complete scenes are skipped, so re-queueing this job resumes the run.
#
# Submit from the repository root (see slurm/README.md): slurm runs a copy of
# this file from its spool, so the checkout is found through the submit
# directory rather than through $0, and --output above is relative to it too.

REPO=${REPO:-${SLURM_SUBMIT_DIR:-$PWD}}
. "$REPO/slurm/common.sh" || { echo "not a dataset_tools checkout: $REPO -- submit from the repository root"; exit 1; }
BAGS=${1:-/mnt/personal/$USER/helhest_new/bags_raw}
OUT=${2:-/mnt/personal/$USER/helhest_new}

PYTHONPATH="$REPO" singularity exec --bind /mnt/personal --bind /mnt/data "$SIF" \
    "$PY" -m dataset_tools.extract "$BAGS" "$OUT" --jobs 8

# Sanity-check what came out (non-zero exit on structural problems).
PYTHONPATH="$REPO" singularity exec --bind /mnt/personal --bind /mnt/data "$SIF" \
    "$PY" -m dataset_tools.validate_scene "$OUT" --csv "$OUT/validation.csv"
