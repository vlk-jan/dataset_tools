REPO=/home/vlkjan6/projects/dataset_tools
CONFIG=mid360_v2.yaml
RATE=1.0
SUBTDATA=vlkjan6@subtdata.felk.cvut.cz
PY="$REPO/.venv/bin/python"

row=$(tail -n +2 "$CSV" | sed -n "$((SLURM_ARRAY_TASK_ID + 1))p")
